# PostgreSQL connection string (Supabase / Neon / Railway / local)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET="change-me"

# Port the API listens on
PORT=4000

# Allowed frontend origin(s), comma-separated
CORS_ORIGIN="http://localhost:3000"

# S3-compatible object storage.
# Works with AWS S3, Supabase Storage (S3 protocol), Cloudflare R2, MinIO.
S3_ENDPOINT="https://<project>.storage.supabase.co/storage/v1/s3"
S3_REGION="us-east-1"
S3_BUCKET="dataroom"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_FORCE_PATH_STYLE="true"
